# .NET Backend API URL
# Local development: http://localhost:5000/api
# Production (Render): https://<your-backend-service>.onrender.com/api
# Set this in the Render dashboard as an environment variable.
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_API_WS_URL="ws://localhost:5000"

# Platform-specific API (for multi-tenant)
NEXT_PUBLIC_PLATFORM_API_URL="http://localhost:5000/api/platform"
