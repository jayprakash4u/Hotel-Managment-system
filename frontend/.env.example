# Secret used to sign session JWTs (hotel-admin and platform-admin cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# .NET Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_API_WS_URL="ws://localhost:5000"

# Platform-specific API (for multi-tenant)
NEXT_PUBLIC_PLATFORM_API_URL="http://localhost:5000/api/platform"