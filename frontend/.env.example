# Secret used to sign session JWTs (hotel-admin and platform-admin cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Local SQL Server Express using the current Windows account.
# Keep the single backslash in the named instance. Server-side only.
DATABASE_URL="sqlserver://JAY\SQLEXPRESS;database=HospitalityDev;integratedSecurity=true;trustServerCertificate=true"
