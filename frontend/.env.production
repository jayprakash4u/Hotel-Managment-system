# Production environment variables for Render frontend deployment
# Copy these values into the Render dashboard environment variables section.
# Do not commit secrets to this file.

# .NET Backend API URL — set to your Render backend service URL
# Example: https://hospitality-api.onrender.com/api
NEXT_PUBLIC_API_URL="https://RENDER_BACKEND_URL.onrender.com/api"

# Platform-specific API (for multi-tenant)
NEXT_PUBLIC_PLATFORM_API_URL="https://RENDER_BACKEND_URL.onrender.com/api/platform"

# Session secret — must match the backend JWT configuration
SESSION_SECRET="replace-with-a-long-random-string-in-production"
