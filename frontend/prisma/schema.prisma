// Prisma Schema for Grand Hospitality Management System
// Multi-tenant: every operational model below is scoped to a Hotel via hotelId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 0. PLATFORM & AUTH
// ----------------------------------------------------

model Hotel {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  address     String
  totalFloors Int        @default(1)
  currency    String     @default("NPR")
  timezone    String     @default("Asia/Kathmandu")
  status      String     @default("ACTIVE") // ACTIVE, SUSPENDED

  adminUser          User?
  roomTypes          RoomType[]
  rooms              Room[]
  guests             Guest[]
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  restaurantTables   RestaurantTable[]
  restaurantOrders   RestaurantOrder[]
  posProducts        POSProduct[]
  inventoryItems     InventoryItem[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  expenses           Expense[]
  cashRegisters      CashRegister[]
  staff              Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Login accounts. PLATFORM_ADMIN rows (software company) have hotelId = null.
// HOTEL_ADMIN rows are the credentials issued to a hotel when it is registered.
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         String    // PLATFORM_ADMIN, HOTEL_ADMIN
  name         String
  hotelId      String?   @unique
  hotel        Hotel?    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ----------------------------------------------------
// 1. HOTEL OPERATIONS
// ----------------------------------------------------

model RoomType {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name        String   // Standard, Deluxe, Suite, Family
  hasAC       Boolean  @default(true)
  bedType     String   @default("King Bed") // King, Queen, Twin, Super King
  maxCapacity Int      @default(2)
  basePrice   Float    @default(0.0)
  amenities   String   @default("[]") @db.Text // JSON string array
  imageUrl    String?
  description String?  @db.Text
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Room {
  id                 String              @id @default(cuid())
  hotelId            String
  hotel              Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roomTypeId         String?
  // Secondary path to Hotel (via RoomType) — kept NoAction so SQL Server doesn't see
  // two cascading paths from Hotel to Room (see hotel field above).
  roomType           RoomType?           @relation(fields: [roomTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  number             String              // Deluxe Suite, Presidential Penthouse, Executive Ocean, Garden Villa, Standard Twin
  floor              Int
  type               String
  hasAC              Boolean             @default(true)
  bedType            String              // King, Queen, Twin, Super King
  pricePerNight      Float
  capacity           Int                 @default(2)
  setupStatus        String              @default("OPERATIONAL") // OPERATIONAL, UNDER_CONSTRUCTION, OUT_OF_SERVICE
  status             String              @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, DIRTY, CLEANING, INSPECTED, MAINTENANCE
  amenities          String              @db.Text // JSON string array
  imageUrl           String
  description        String              @db.Text
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  orders             RestaurantOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([hotelId, number])
}

model Guest {
  id            String            @id @default(cuid())
  hotelId       String
  hotel         Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  firstName     String
  lastName      String
  email         String
  phone         String
  idNumber      String            // Passport / National ID
  idType        String            @default("Passport")
  country       String            @default("United States")
  vipTier       String            @default("STANDARD") // STANDARD, SILVER, GOLD, PLATINUM, DIAMOND
  loyaltyPoints Int               @default(0)
  preferences   String?           @db.Text // Dietary, pillow, floor preferences
  notes         String?           @db.Text
  reservations  Reservation[]
  orders        RestaurantOrder[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([hotelId, email])
}

model Reservation {
  id              String         @id @default(cuid())
  hotelId         String
  hotel           Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookingCode     String         // RES-XXXXXX
  guestId         String
  // Secondary paths to Hotel (via Guest / via Room) — kept NoAction so SQL Server
  // doesn't see multiple cascading paths from Hotel to Reservation (see hotel field above).
  guest           Guest          @relation(fields: [guestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomId          String
  room            Room           @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkIn         DateTime
  checkOut        DateTime
  adults          Int            @default(1)
  children        Int            @default(0)
  status          String         @default("CONFIRMED") // CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  totalAmount     Float
  paidAmount      Float          @default(0)
  paymentStatus   String         @default("UNPAID") // UNPAID, PARTIAL, PAID, REFUNDED
  source          String         @default("DIRECT") // DIRECT, ONLINE, OTA, WALK_IN
  specialRequests String?        @db.Text
  folioItems      FolioItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([hotelId, bookingCode])
}

model HousekeepingTask {
  id          String     @id @default(cuid())
  hotelId     String
  hotel       Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roomId      String
  // Secondary path to Hotel (via Room) — kept NoAction, see hotel field above.
  room        Room       @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedTo  String     // Staff Name
  taskType    String     // FULL_CLEAN, TOUCH_UP, TURNDOWN, DEEP_CLEAN, INSPECTION
  priority    String     @default("NORMAL") // URGENT, HIGH, NORMAL, LOW
  status      String     @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  notes       String?    @db.Text
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MaintenanceTicket {
  id          String     @id @default(cuid())
  hotelId     String
  hotel       Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticketCode  String     // MNT-XXXX
  roomId      String
  // Secondary path to Hotel (via Room) — kept NoAction, see hotel field above.
  room        Room       @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  description String     @db.Text
  category    String     // PLUMBING, HVAC, ELECTRICAL, FURNITURE, APPLIANCE, OTHER
  priority    String     @default("HIGH") // URGENT, HIGH, NORMAL, LOW
  status      String     @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  reportedBy  String     @default("Housekeeping")
  assignedTo  String?
  reportedAt  DateTime   @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime   @updatedAt

  @@unique([hotelId, ticketCode])
}

// ----------------------------------------------------
// 2. CAFE / RESTAURANT (F&B / OUTLETS)
// ----------------------------------------------------

model RestaurantTable {
  id          String            @id @default(cuid())
  hotelId     String
  hotel       Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tableNumber String            // T1, T2, VIP-1, PATIO-3
  section     String            // Indoor Fine Dining, Skyline Rooftop Terrace, Poolside Lounge, VIP Private Room
  capacity    Int               @default(4)
  status      String            @default("FREE") // FREE, OCCUPIED, RESERVED, BILLED
  orders      RestaurantOrder[]

  @@unique([hotelId, tableNumber])
}

model RestaurantOrder {
  id            String                @id @default(cuid())
  hotelId       String
  hotel         Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orderNumber   String                // ORD-XXXX
  kotNumber     String                // KOT-XXXX
  outlet        String                @default("RESTAURANT") // RESTAURANT, ROOFTOP_BAR, ZENITH_SPA, ROOM_SERVICE
  tableId       String?
  // Secondary paths to Hotel (via Table / Room / Guest) — kept NoAction, see hotel field above.
  table         RestaurantTable?      @relation(fields: [tableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomId        String?
  room          Room?                 @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guestId       String?
  guest         Guest?                @relation(fields: [guestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status        String                @default("RECEIVED") // RECEIVED, PREPARING, READY, SERVED, BILLED, CANCELLED
  orderType     String                @default("DINE_IN") // DINE_IN, ROOM_SERVICE, TAKEAWAY
  serverName    String                @default("David Kim")
  items         RestaurantOrderItem[]
  subtotal      Float
  tax           Float                 @default(0)
  serviceCharge Float                 @default(0)
  total         Float
  paymentMethod String?               // ROOM_FOLIO, CASH, CARD, UPI
  isPaid        Boolean               @default(false)
  notes         String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([hotelId, orderNumber])
}

model RestaurantOrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productId   String
  productName String
  unitPrice   Float
  quantity    Int             @default(1)
  total       Float
  notes       String?         @db.Text
}

model POSProduct {
  id          String     @id @default(cuid())
  hotelId     String
  hotel       Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outlet      String     // RESTAURANT, ROOFTOP_BAR, ZENITH_SPA, ROOM_SERVICE, MINIBAR
  category    String     // Starters, Mains, Desserts, Cocktails, Spa Treatments, etc.
  name        String
  description String?    @db.Text
  price       Float
  stock       Int        @default(100)
  imageUrl    String?
}

// ----------------------------------------------------
// 3. INVENTORY & PURCHASES
// ----------------------------------------------------

model InventoryItem {
  id            String          @id @default(cuid())
  hotelId       String
  hotel         Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name          String
  category      String          // LINEN, TOILETRIES, BEVERAGES, FOOD_RAW, CLEANING_SUPPLIES, MINIBAR
  sku           String          @default(cuid())
  currentStock  Int
  minThreshold  Int
  unit          String          // pieces, bottles, kg, boxes, sets
  costPerUnit   Float
  supplierId    String?
  // Secondary path to Hotel (via Supplier) — kept NoAction, see hotel field above.
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movements     StockMovement[]
  lastRestocked DateTime        @default(now())

  @@unique([hotelId, sku])
}

model Supplier {
  id          String          @id @default(cuid())
  hotelId     String
  hotel       Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name        String
  contactName String
  email       String
  phone       String
  address     String?
  category    String          // F&B Supplies, Linen & Fabric, Luxury Amenities, Beverages
  items       InventoryItem[]
  purchases   PurchaseOrder[]
  createdAt   DateTime        @default(now())
}

model PurchaseOrder {
  id          String        @id @default(cuid())
  hotelId     String
  hotel       Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  poNumber    String        // PO-2026-XXXX
  supplierId  String
  // Secondary path to Hotel (via Supplier) — kept NoAction, see hotel field above.
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  totalAmount Float
  status      String        @default("RECEIVED") // PENDING, ORDERED, RECEIVED, CANCELLED
  itemsJson   String        @db.Text // JSON array of purchased items
  orderedAt   DateTime      @default(now())
  receivedAt  DateTime?

  @@unique([hotelId, poNumber])
}

model StockMovement {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quantity    Int
  type        String        // PURCHASE, POS_CONSUMPTION, HOUSEKEEPING_USAGE, WASTAGE, ADJUSTMENT
  reason      String?
  performedBy String        @default("Inventory Manager")
  createdAt   DateTime      @default(now())
}

// ----------------------------------------------------
// 4. FINANCE & CASH REGISTER
// ----------------------------------------------------

model FolioItem {
  id            String       @id @default(cuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outlet        String       // ROOM_CHARGE, RESTAURANT, ROOFTOP_BAR, ZENITH_SPA, ROOM_SERVICE, MINIBAR, LAUNDRY, TAX, DISCOUNT
  description   String       @db.Text
  unitPrice     Float
  quantity      Int          @default(1)
  total         Float
  billedBy      String       @default("Front Desk")
  timestamp     DateTime     @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenseCode String   // EXP-XXXX
  category    String   // Utilities, Maintenance Supplies, F&B Raw Materials, Staff Welfare, Marketing
  description String   @db.Text
  amount      Float
  paymentMode String   // CASH_REGISTER, BANK_TRANSFER, CORPORATE_CARD
  paidTo      String
  paidBy      String   @default("Finance Manager")
  date        DateTime @default(now())

  @@unique([hotelId, expenseCode])
}

model CashRegister {
  id           String    @id @default(cuid())
  hotelId      String
  hotel        Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shift        String    // Morning (07:00-15:30), Evening (15:00-23:30), Night (23:00-07:30)
  cashierName  String
  openingFloat Float     @default(500.0)
  closingCash  Float?
  cashSales    Float     @default(0.0)
  cardSales    Float     @default(0.0)
  roomCharges  Float     @default(0.0)
  expensesPaid Float     @default(0.0)
  status       String    @default("OPEN") // OPEN, CLOSED
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
}

// ----------------------------------------------------
// 5. PEOPLE & STAFF
// ----------------------------------------------------

model Staff {
  id        String     @id @default(cuid())
  hotelId   String
  hotel     Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name      String
  email     String
  role      String     // ADMIN, FRONT_DESK, HOUSEKEEPING, POS_CASHIER, CONCIERGE, CHEF, FINANCE
  avatar    String
  shift     String     @default("Morning (07:00 - 15:30)")

  @@unique([hotelId, email])
}
