{
  "name": "hospitality-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c green,blue --kill-others-on-fail \"npm run dev --workspace=frontend\" \"npm run backend:run\"",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspace=frontend",
    "backend:build": "cd backend && dotnet build Hospitality.sln",
    "backend:run": "cd backend/src/Hospitality.Api && dotnet run",
    "backend:watch": "cd backend/src/Hospitality.Api && dotnet watch run",
    "backend:test": "cd backend && dotnet test Hospitality.sln",
    "db:generate": "npm run db:generate --workspace=frontend",
    "db:validate": "npm run db:validate --workspace=frontend",
    "db:update": "npm run db:update --workspace=frontend",
    "db:studio": "npm run db:studio --workspace=frontend",
    "clean": "rm -rf frontend/.next frontend/node_modules backend/**/bin backend/**/obj",
    "install:all": "npm install && npm run db:generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
