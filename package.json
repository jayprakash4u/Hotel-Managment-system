{
  "name": "hospitality-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspace=frontend",
    "backend:build": "cd backend && dotnet build Hospitality.sln",
    "backend:run": "cd backend/src/Hospitality.Api && dotnet run",
    "backend:watch": "cd backend/src/Hospitality.Api && dotnet watch run",
    "backend:test": "cd backend && dotnet test Hospitality.sln",
    "db:generate": "cd backend/src/Hospitality.Persistence && dotnet ef migrations add InitialCreate",
    "db:update": "cd backend/src/Hospitality.Persistence && dotnet ef database update",
    "clean": "rm -rf frontend/.next frontend/node_modules backend/**/bin backend/**/obj",
    "install:all": "npm install && cd backend && dotnet restore"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}